{
  "name": "start-web",
  "description": "Start my web development environment",
  "steps": [
    {
      "action": "open_app",
      "app": "vscode"
    },
    {
      "action": "change_directory",
      "path": "${projects.web}"
    },
    {
      "action": "run_command",
      "command": "npm run dev"
    },
    {
      "action": "wait",
      "seconds": 3
    },
    {
      "action": "open_url",
      "url": "http://localhost:3000"
    }
  ]
}
